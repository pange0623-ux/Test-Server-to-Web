                </rule>
                <rule name="Imported Rule 6" enabled="true" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{URL}" pattern="^/store/.*\.zip$" ignoreCase="false" />
                    </conditions>
                    <action type="Redirect" url="http://212.224.88.213/yaarsa/403.php" />
                </rule>
                <rule name="Imported Rule 7" enabled="true" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{URL}" pattern="^/store/.*\.zip$" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="None" />
                </rule>
                <rule name="Imported Rule 8" enabled="false" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{URL}" pattern="^/user/storage/.*Prof\.png$" ignoreCase="false" />
                    </conditions>
                    <action type="None" />
                </rule>
                <rule name="Imported Rule 9" enabled="false" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{URL}" pattern="^/user/storage/" ignoreCase="false" />
                    </conditions>
                    <action type="Redirect" url="http://212.224.88.213/yaarsa/403.php" />
                </rule>
				 <rule name="Block Vendor Folder" enabled="true" stopProcessing="true">
					<match url="^vendor/.*" ignoreCase="true" />
					<action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access to this directory is forbidden." />
				</rule>
            </rules>
        </rewrite>
        <httpErrors errorMode="DetailedLocalOnly" />
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
        </staticContent>
       
    </system.webServer>
